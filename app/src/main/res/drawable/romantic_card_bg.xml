<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />

    <gradient
        android:startColor="#26132D"
        android:centerColor="#32163C"
        android:endColor="#26132D"
        android:angle="270"
        android:type="linear" />

    <stroke
        android:width="1.5dp"
        android:color="#FF4C8FFF" />

    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
</shape>
