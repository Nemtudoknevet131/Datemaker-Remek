<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warm romantic gradient, a bit brighter than the background -->
    <gradient
        android:startColor="#FF4C76"
        android:centerColor="#FF2F63"
        android:endColor="#CC1F4A"
        android:angle="270"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />

    <corners
        android:topLeftRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:topRightRadius="6dp"
        android:bottomRightRadius="6dp" />

    <padding
        android:left="10dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="6dp" />
</shape>