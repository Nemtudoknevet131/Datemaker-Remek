<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#000000"
                android:endColor="#001A00" />
        </shape>
    </item>

    <item android:left="24dp" android:top="24dp"
        android:right="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400"
                android:centerX="50%"
                android:centerY="30%"
                android:startColor="#222F22"
                android:endColor="#000000" />
        </shape>
    </item>

    <!-- Neon green frame -->
    <item android:left="12dp" android:top="12dp"
        android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#18FF4F" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item android:left="24dp" android:top="24dp"
        android:right="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#108F3A"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>
