<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_left"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Placeholder for the top image/banner -->
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/romantic_card_bg" 
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/closeButton"
        android:layout_marginTop="16dp"/>
    
    <!-- "ADS" crossed out placeholder - using text for now if no icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NO ADS"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="#FFFFFF"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="@id/bannerImage"
        app:layout_constraintEnd_toEndOf="@id/bannerImage"
        app:layout_constraintTop_toTopOf="@id/bannerImage"
        app:layout_constraintBottom_toBottomOf="@id/bannerImage"/>

    <LinearLayout
        android:id="@+id/featuresLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/bannerImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No\nAds"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp"
            android:background="@drawable/bubble_button_bg"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI\nFeatures"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp"
            android:background="@drawable/bubble_button_bg"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unlock All\nFeatures"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp"
            android:background="@drawable/bubble_button_bg"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Around\nMe"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp"
            android:background="@drawable/bubble_button_bg"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/trialText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Try 3 days for free. Then 9.99 USD/ month"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/featuresLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/subscriptionOptions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/trialText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Monthly -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_button_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9.99 USD / Month"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3-days FREE trial"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Yearly -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_button_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29.99 USD / Year"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Lifetime -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/romantic_card_bg"
            android:padding="12dp"
            android:gravity="center">
            
            <!-- Badge placeholder -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save 80%"
                android:background="#4CAF50"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:padding="2dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24.99 USD / Lifetime"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One-Time payment"
                android:textColor="#DDDDDD"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/continueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/subscriptionOptions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/cancelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel anytime"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/continueButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/continueLimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continue limited use"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>