<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/romantic_gradient_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardRelationship"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardCornerRadius="20dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@android:color/transparent" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/romantic_card_bg"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/layoutCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <TextView
                            android:id="@+id/tvCoinsTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_0"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:id="@+id/ivCoinIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icon_coin" />
                    </LinearLayout>

                </LinearLayout>

                <!-- AVATAR AREA -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp">

                    <!-- User avatar: left, behind -->
                    <ImageView
                        android:id="@+id/ivMeAvatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center_vertical|start"
                        android:translationX="70dp"
                        android:rotation="-25"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_filled" />

                    <!-- Partner avatar: right, on top -->
                    <ImageView
                        android:id="@+id/ivPartnerAvatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center_vertical|end"
                        android:translationX="-70dp"
                        android:rotation="25"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_filled" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvCombinedNames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/you_partner"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvTogetherSince"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/tap_here_to_set_your_special_date"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvPlaceHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/more_shit_about_the_relationship_later"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
