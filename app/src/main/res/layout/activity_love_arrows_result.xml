<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/romantic_gradient_bg"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvLastScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/score_0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvHighScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0_npartner"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvCoinsEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coins_0"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:layout_marginBottom="8dp" /> 
    
    <TextView
        android:id="@+id/tvCoupleCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_together_0"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />
    
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDoubleCoins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/coins_x2"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:textAllCaps="false" />
</LinearLayout>